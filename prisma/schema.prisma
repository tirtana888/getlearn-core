datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  tokenBalance Int      @default(100000) @map("token_balance")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  learners         Learner[]
  objectives       LearningObjective[]
  contentItems     ContentItem[]
  assessmentItems  AssessmentItem[]
  assessmentEvents AssessmentEvent[]
  masteryRecords   MasteryRecord[]
  lessonProgress   LessonProgress[]
  contentChunks    ContentChunk[]
  chatSessions     ChatSession[]
  frappeConnection FrappeConnection?

  @@map("tenants")
}

// Pull-based sync config for a tenant whose source LMS is Frappe/Frappe LMS.
// getlearn.ai calls OUT to the Frappe site's own REST API on a schedule -
// nothing is pushed from the Frappe side for this. See FrappeSyncService.
model FrappeConnection {
  id                   String    @id @default(uuid())
  tenantId             String    @unique @map("tenant_id")
  baseUrl              String    @map("base_url")
  apiKey               String    @map("api_key")
  apiSecret            String    @map("api_secret")
  enabled              Boolean   @default(true)
  lastSyncedAt         DateTime? @map("last_synced_at")
  lastProgressSyncedAt DateTime? @map("last_progress_synced_at")
  lastSyncError        String?   @map("last_sync_error") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("frappe_connections")
}

model Learner {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  externalRef String   @map("external_ref") // Opaque ID from LMS (no PII)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessmentEvents AssessmentEvent[]
  masteryRecords   MasteryRecord[]
  lessonProgress   LessonProgress[]
  chatSessions     ChatSession[]

  @@unique([tenantId, externalRef])
  @@index([tenantId])
  @@map("learners")
}

model LearningObjective {
  id        String   @id // canonical ID scoped per tenant (e.g. obj_fraction_add)
  tenantId  String   @map("tenant_id")
  label     String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masteryRecords MasteryRecord[]
  lessonProgress LessonProgress[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("learning_objectives")
}

enum ContentType {
  text
  video
  pdf
  scorm
}

enum IndexingStatus {
  pending
  completed
  failed
  skipped
}

model ContentItem {
  id             String         @id // canonical ID (e.g. lesson_123)
  tenantId       String         @map("tenant_id")
  type           ContentType
  sourceUri      String?        @map("source_uri")
  rawText        String?        @map("raw_text") @db.Text
  objectiveIds   String[]       @map("objective_ids") // List of LearningObjective IDs
  indexingStatus IndexingStatus @default(skipped) @map("indexing_status")
  indexingError  String?        @map("indexing_error") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks ContentChunk[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("content_items")
}

model ContentChunk {
  id            String                      @id @default(uuid())
  tenantId      String                      @map("tenant_id")
  contentItemId String                      @map("content_item_id")
  chunkIndex    Int                         @map("chunk_index")
  chunkText     String                      @map("chunk_text") @db.Text
  embedding     Unsupported("vector(768)")?
  createdAt     DateTime                    @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, contentItemId])
  @@map("content_chunks")
}

enum AssessmentType {
  mcq
  short
  essay
}

model AssessmentItem {
  id           String         @id // canonical ID (e.g. q_2451)
  tenantId     String         @map("tenant_id")
  itemType     AssessmentType @map("item_type")
  promptText   String         @map("prompt_text")
  objectiveIds String[]       @map("objective_ids") // List of LearningObjective IDs tested
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessmentEvents AssessmentEvent[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("assessment_items")
}

model AssessmentEvent {
  id          String   @id // Idempotency key from connector (e.g. evt_quiz_981)
  tenantId    String   @map("tenant_id")
  learnerId   String   @map("learner_id")
  itemId      String   @map("item_id")
  isCorrect   Boolean  @map("is_correct")
  rawResponse String?  @map("raw_response")
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  item    AssessmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, learnerId])
  @@index([tenantId, itemId])
  @@map("assessment_events")
}

model MasteryRecord {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  learnerId     String   @map("learner_id")
  objectiveId   String   @map("objective_id")
  score         Float    @default(0.0) // 0.00 to 1.00
  evidenceCount Int      @default(0) @map("evidence_count")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner   Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  objective LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([tenantId, learnerId, objectiveId])
  @@index([tenantId, learnerId])
  @@map("mastery_records")
}

enum ChatScope {
  objective
  learner
}

enum ChatSender {
  user
  assistant
}

model ChatSession {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  learnerId    String    @map("learner_id")
  scope        ChatScope
  objectiveIds String[]  @map("objective_ids") // For objective-scoped sessions
  title        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner  Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([tenantId, learnerId])
  @@map("chat_sessions")
}

model ChatMessage {
  id               String     @id @default(uuid())
  sessionId        String     @map("session_id")
  sender           ChatSender
  content          String     @db.Text
  sourceContentIds String[]   @map("source_content_ids") // Badges / lesson citations
  audioUrl         String?    @map("audio_url") // Fish Audio TTS URL if voice requested
  createdAt        DateTime   @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

enum ProgressStatus {
  complete
  partial
}

// How far a learner has got through a lesson - deliberately NOT folded into
// MasteryRecord: progress is "how much did they get through", mastery is
// "how well did they do on the assessment". The lesson is the objective, same
// mapping quiz results use, so both signals hang off the same LearningObjective.
model LessonProgress {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  learnerId      String         @map("learner_id")
  lessonId       String         @map("lesson_id") // LearningObjective.id
  courseId       String?        @map("course_id")
  status         ProgressStatus
  sourceModified DateTime       @map("source_modified")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner   Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  objective LearningObjective @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([tenantId, learnerId, lessonId])
  @@index([tenantId, learnerId])
  @@map("lesson_progress")
}
