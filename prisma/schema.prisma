datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  tokenBalance Int      @default(100000) @map("token_balance")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  learners              Learner[]
  objectives            LearningObjective[]
  contentItems          ContentItem[]
  assessmentItems       AssessmentItem[]
  assessmentEvents      AssessmentEvent[]
  masteryRecords        MasteryRecord[]
  lessonProgress        LessonProgress[]
  enrollments           Enrollment[]
  contentChunks         ContentChunk[]
  chatSessions          ChatSession[]
  frappeConnection      FrappeConnection?
  courseChapters        CourseChapter[]
  quizAttempts          QuizAttempt[]
  assignments           Assignment[]
  assignmentSubmissions AssignmentSubmission[]

  @@map("tenants")
}

// Pull-based sync config for a tenant whose source LMS is Frappe/Frappe LMS.
// getlearn.ai calls OUT to the Frappe site's own REST API on a schedule -
// nothing is pushed from the Frappe side for this. See FrappeSyncService.
model FrappeConnection {
  id                   String    @id @default(uuid())
  tenantId             String    @unique @map("tenant_id")
  baseUrl              String    @map("base_url")
  apiKey               String    @map("api_key")
  apiSecret            String    @map("api_secret")
  enabled              Boolean   @default(true)
  lastSyncedAt         DateTime? @map("last_synced_at")
  lastProgressSyncedAt DateTime? @map("last_progress_synced_at")
  lastCatalogSyncedAt  DateTime? @map("last_catalog_synced_at")
  lastSyncError        String?   @map("last_sync_error") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("frappe_connections")
}

model Learner {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  externalRef String   @map("external_ref") // Opaque ID from LMS (no PII)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessmentEvents      AssessmentEvent[]
  masteryRecords        MasteryRecord[]
  lessonProgress        LessonProgress[]
  enrollments           Enrollment[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  chatSessions          ChatSession[]

  @@unique([tenantId, externalRef])
  @@index([tenantId])
  @@map("learners")
}

model LearningObjective {
  id            String   @id // canonical ID scoped per tenant (e.g. obj_fraction_add)
  tenantId      String   @map("tenant_id")
  label         String
  parentId      String?  @map("parent_id")
  courseId      String?  @map("course_id")
  courseLabel   String?  @map("course_label")
  sequence      Int? // order of this lesson within its course
  chapterId     String?  @map("chapter_id") // LMS chapter this lesson belongs to
  assessmentRef String?  @map("assessment_ref") // id of the quiz attached to this lesson, if any
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masteryRecords MasteryRecord[]
  lessonProgress LessonProgress[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("learning_objectives")
}

enum ContentType {
  text
  video
  pdf
  scorm
}

enum IndexingStatus {
  pending
  completed
  failed
  skipped
}

model ContentItem {
  id             String         @id // canonical ID (e.g. lesson_123)
  tenantId       String         @map("tenant_id")
  type           ContentType
  sourceUri      String?        @map("source_uri")
  rawText        String?        @map("raw_text") @db.Text
  objectiveIds   String[]       @map("objective_ids") // List of LearningObjective IDs
  indexingStatus IndexingStatus @default(skipped) @map("indexing_status")
  indexingError  String?        @map("indexing_error") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks ContentChunk[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("content_items")
}

model ContentChunk {
  id            String                      @id @default(uuid())
  tenantId      String                      @map("tenant_id")
  contentItemId String                      @map("content_item_id")
  chunkIndex    Int                         @map("chunk_index")
  chunkText     String                      @map("chunk_text") @db.Text
  embedding     Unsupported("vector(768)")?
  createdAt     DateTime                    @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, contentItemId])
  @@map("content_chunks")
}

enum AssessmentType {
  mcq
  short
  essay
}

model AssessmentItem {
  id           String         @id // canonical ID (e.g. q_2451)
  tenantId     String         @map("tenant_id")
  itemType     AssessmentType @map("item_type")
  promptText   String         @map("prompt_text")
  objectiveIds String[]       @map("objective_ids") // List of LearningObjective IDs tested
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessmentEvents AssessmentEvent[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("assessment_items")
}

model AssessmentEvent {
  id          String   @id // Idempotency key from connector (e.g. evt_quiz_981)
  tenantId    String   @map("tenant_id")
  learnerId   String   @map("learner_id")
  itemId      String   @map("item_id")
  isCorrect   Boolean  @map("is_correct")
  rawResponse String?  @map("raw_response")
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  item    AssessmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, learnerId])
  @@index([tenantId, itemId])
  @@map("assessment_events")
}

model MasteryRecord {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  learnerId     String   @map("learner_id")
  objectiveId   String   @map("objective_id")
  score         Float    @default(0.0) // 0.00 to 1.00
  evidenceCount Int      @default(0) @map("evidence_count")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner   Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  objective LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([tenantId, learnerId, objectiveId])
  @@index([tenantId, learnerId])
  @@map("mastery_records")
}

enum ChatScope {
  objective
  learner
}

enum ChatSender {
  user
  assistant
}

model ChatSession {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  learnerId    String    @map("learner_id")
  scope        ChatScope
  objectiveIds String[]  @map("objective_ids") // For objective-scoped sessions
  title        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner  Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([tenantId, learnerId])
  @@map("chat_sessions")
}

model ChatMessage {
  id               String     @id @default(uuid())
  sessionId        String     @map("session_id")
  sender           ChatSender
  content          String     @db.Text
  sourceContentIds String[]   @map("source_content_ids") // Badges / lesson citations
  audioUrl         String?    @map("audio_url") // Fish Audio TTS URL if voice requested
  // --- analytics (assistant messages only; null on older rows) ---
  outcome          String? // answered | no_material | vague_fallback | provider_failed | dev_fallback
  provider         String? // gemini | deepseek
  tokensUsed       Int?       @map("tokens_used")
  latencyMs        Int?       @map("latency_ms")
  retrievalCount   Int?       @map("retrieval_count") // passages handed to the model
  topSimilarity    Float?     @map("top_similarity") // best passage score; null when none matched / lesson-start fallback
  guardrail        String? // why hint-only mode was on, if it was
  feedback         Int? // learner thumbs: 1 up, -1 down
  feedbackAt       DateTime?  @map("feedback_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

enum ProgressStatus {
  complete
  partial
}

// How far a learner has got through a lesson - deliberately NOT folded into
// MasteryRecord: progress is "how much did they get through", mastery is
// "how well did they do on the assessment". The lesson is the objective, same
// mapping quiz results use, so both signals hang off the same LearningObjective.
model LessonProgress {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  learnerId      String         @map("learner_id")
  lessonId       String         @map("lesson_id") // LearningObjective.id
  courseId       String?        @map("course_id")
  status         ProgressStatus
  sourceModified DateTime       @map("source_modified")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner   Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  objective LearningObjective @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([tenantId, learnerId, lessonId])
  @@index([tenantId, learnerId])
  @@map("lesson_progress")
}

// A learner's enrollment in a course (what "your courses" means for recommendations).
model Enrollment {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  learnerId      String    @map("learner_id")
  courseId       String    @map("course_id")
  courseLabel    String?   @map("course_label")
  progressPct    Float     @default(0) @map("progress_pct")
  // Anchors for the LMS's drip / deadline rules (date part of LMS Enrollment.creation, and the batch start).
  enrolledAt     DateTime? @map("enrolled_at")
  batchId        String?   @map("batch_id")
  batchStartDate DateTime? @map("batch_start_date")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, learnerId, courseId])
  @@index([tenantId, learnerId])
  @@map("enrollments")
}

// A chapter of a course with its release (drip) and deadline rules, pulled from the LMS.
// getlearn evaluates the rules per learner itself, so no LMS-side code is involved.
model CourseChapter {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  chapterId    String    @map("chapter_id") // the LMS's own chapter id
  courseId     String    @map("course_id")
  title        String
  sequence     Int?
  dripType     String?   @map("drip_type") // "On a fixed date" | "Days after enrollment" | "Days after batch start"
  dripDate     DateTime? @map("drip_date")
  dripDays     Int?      @map("drip_days")
  deadlineDays Int?      @map("deadline_days")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, chapterId])
  @@index([tenantId, courseId])
  @@map("course_chapters")
}

model Assignment {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  assignmentId     String    @map("assignment_id") // the LMS's own assignment id
  courseId         String?   @map("course_id")
  title            String
  enableScheduling Boolean   @default(false) @map("enable_scheduling")
  scheduleStart    DateTime? @map("schedule_start")
  scheduleEnd      DateTime? @map("schedule_end")
  deadlineType     String?   @map("deadline_type") // "Fixed date" | "Days after release"
  deadlineDays     Int?      @map("deadline_days")
  dripType         String?   @map("drip_type")
  dripDate         DateTime? @map("drip_date")
  dripDays         Int?      @map("drip_days")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, assignmentId])
  @@index([tenantId, courseId])
  @@map("assignments")
}

// Only the status of a learner's submission - never its content.
model AssignmentSubmission {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  learnerId      String   @map("learner_id")
  assignmentId   String   @map("assignment_id")
  status         String // "Pass" | "Fail" | "Not Graded" | "Not Applicable"
  sourceModified DateTime @map("source_modified")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, learnerId, assignmentId])
  @@index([tenantId, learnerId])
  @@map("assignment_submissions")
}

// One attempt at a quiz, as the LMS recorded it (its own score, out-of and pass mark). Separate
// from mastery, which is derived per lesson from individual answers.
model QuizAttempt {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  learnerId         String   @map("learner_id")
  submissionId      String   @map("submission_id") // the LMS's own submission id
  quizId            String   @map("quiz_id")
  quizTitle         String   @map("quiz_title")
  courseId          String?  @map("course_id")
  score             Int?
  scoreOutOf        Int?     @map("score_out_of")
  percentage        Int?
  passingPercentage Int?     @map("passing_percentage")
  submittedAt       DateTime @map("submitted_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, submissionId])
  @@index([tenantId, learnerId])
  @@map("quiz_attempts")
}
